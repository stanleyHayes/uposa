# Mobile dev override for the API base URL.
# Required when running on a physical device (localhost on your Mac is not
# reachable from the phone). Set this to your Mac's LAN IP, e.g.:
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:5000/api
#
# When unset, the app falls back to app.json#extra.apiUrl
# (http://localhost:5000/api), which works in the iOS Simulator and
# Android emulator.
EXPO_PUBLIC_API_URL=
