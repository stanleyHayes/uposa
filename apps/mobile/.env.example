# Mobile dev override for the API base URL.
# Required when running on a physical device (localhost on your Mac is not
# reachable from the phone). Set this to your Mac's LAN IP, e.g.:
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:5001/api
#
# When unset, dev builds use http://localhost:5001/api (works in the iOS
# Simulator) and release builds use app.json#extra.apiUrl
# (https://uposa.onrender.com/api). EAS builds set it per profile in eas.json.
EXPO_PUBLIC_API_URL=
