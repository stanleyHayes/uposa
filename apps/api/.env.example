# Database (MongoDB)
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/uposa?retryWrites=true&w=majority"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_ADMIN_SECRET="your-super-secret-admin-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Email (Resend)
RESEND_API_KEY="re_your_resend_api_key"
FROM_EMAIL="UPOSA <noreply@uposa.org>"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# URLs
CLIENT_URL="http://localhost:3000"
ADMIN_URL="http://localhost:5173"

# Server
PORT=5001
NODE_ENV="development"

# Payment (credentials are primarily managed via admin dashboard, stored encrypted in DB)
# These env vars are optional fallbacks for local development
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_PUBLIC_KEY=""
STRIPE_WEBHOOK_SECRET=""
CRYPTO_API_KEY=""
CRYPTO_WEBHOOK_SECRET=""
PAYMENT_CALLBACK_BASE_URL="http://localhost:3000"

# Encryption key for payment credentials stored in DB (32 chars, generate with: openssl rand -hex 16)
CREDENTIALS_ENCRYPTION_KEY="change-this-to-a-32-char-secret!"

# AI writing assistant (admin dashboard). Optional — feature is disabled (503) if OPENAI_API_KEY is unset.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.5"
AI_WRITING_LIMIT_PER_HOUR=30
