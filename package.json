{
  "name": "uposa-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "UPOSA - University Practice Old Students Association Monorepo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:marketing": "npm run dev -w apps/marketing",
    "dev:admin": "npm run dev -w apps/admin",
    "dev:alumni": "npm run dev -w apps/alumni",
    "dev:mobile": "npm run start -w apps/mobile",
    "dev:mobile:ios": "npm run ios -w apps/mobile",
    "dev:mobile:android": "npm run android -w apps/mobile",
    "dev:api": "npm run dev -w apps/api",
    "build:marketing": "npm run build -w apps/marketing",
    "build:admin": "npm run build -w apps/admin",
    "build:alumni": "npm run build -w apps/alumni",
    "build:api": "npm run build -w apps/api",
    "build": "npm run build:api && npm run build:admin && npm run build:alumni && npm run build:marketing",
    "lint:admin": "npm run lint -w apps/admin",
    "lint:alumni": "npm run lint -w apps/alumni",
    "lint:marketing": "npm run lint -w apps/marketing",
    "lint:api": "npm run lint -w apps/api",
    "lint:mobile": "npm run lint -w apps/mobile",
    "lint": "npm run lint:api && npm run lint:admin && npm run lint:alumni && npm run lint:marketing && npm run lint:mobile",
    "test": "npm run test -w apps/api",
    "test:integration": "npm run test:integration -w apps/api",
    "test:e2e": "playwright test",
    "dev": "concurrently \"npm run dev:marketing\" \"npm run dev:admin\" \"npm run dev:alumni\" \"npm run dev:api\"",
    "seed": "npm run seed -w apps/api"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "concurrently": "^10.0.3"
  },
  "overrides": {
    "react-native": {
      "react": "19.2.7",
      "react-dom": "19.2.7"
    },
    "expo-router": {
      "react": "19.2.7",
      "react-dom": "19.2.7"
    },
    "expo": {
      "react": "19.2.7",
      "react-dom": "19.2.7"
    },
    "react-native-web": {
      "react": "19.2.7",
      "react-dom": "19.2.7"
    },
    "@babel/core": "7.29.7",
    "express": "5.2.1",
    "form-data": "4.0.6",
    "qs": "6.15.2",
    "engine.io": {
      ".": "6.6.9",
      "ws": "8.21.0"
    },
    "engine.io-client": {
      ".": "6.6.6",
      "ws": "8.21.0"
    },
    "socket.io-adapter": {
      ".": "2.5.8",
      "ws": "8.21.0"
    },
    "react-devtools-core": {
      "ws": "7.5.11"
    }
  }
}
